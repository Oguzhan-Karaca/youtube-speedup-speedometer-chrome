{
  "manifest_version": 3,
  "name": "YouTube SpeedUp Speedometer",
  "version": "1.0.0",
  "description": "Control YouTube playback speed with a beautiful speedometer control - Mouse wheel to adjust, click to reset",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
